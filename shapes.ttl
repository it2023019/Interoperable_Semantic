@prefix base: <https://w3id.org/tonyawards/ontology#> .
@prefix base: <http://www.owl-ontologies.com/base#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# 1. Validation for Ceremonies
base:CeremonyShape a sh:NodeShape ;
    sh:targetClass base:Ceremony ;
    sh:property [
        sh:path base:year ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1947 ;
        sh:name "Year of the ceremony" ;
    ] ;
    sh:property [
        sh:path base:ceremonyNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
    ] .

# 2. Validation for Productions
base:ProductionShape a sh:NodeShape ;
    sh:targetClass base:Production ;
    sh:property [
        sh:path base:title ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path base:isWinner ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] .

# 3. Validation for Theaters
base:TheaterShape a sh:NodeShape ;
    sh:targetClass base:Theater ;
    sh:property [
        sh:path base:capacity ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:name "Seating capacity" ;
    ] .

# 4. Validation for Persons
base:PersonShape a sh:NodeShape ;
    sh:targetClass base:Person ;
    sh:property [
        sh:path base:name ;
        sh:datatype xsd:string ;
        sh:minLength 2 ;
        sh:minCount 1 ;
    ] .
