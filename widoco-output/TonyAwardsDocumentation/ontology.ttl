@prefix : <https://w3id.org/tonyawards/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/tonyawards/ontology#> .

<https://w3id.org/tonyawards/ontology#> rdf:type owl:Ontology ;
                                         owl:versionIRI <https://w3id.org/tonyawards/ontology/1.0.0#> ;
                                         <http://purl.org/dc/terms/created> "2026-05-17" ;
                                         <http://purl.org/dc/terms/creator> "Group7" ;
                                         <http://purl.org/dc/terms/description> "An ontology representing the Tony Awards, productions, theaters, and artists."@en ;
                                         <http://purl.org/dc/terms/issued> "2026-05-17" ;
                                         <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/4.0/> ;
                                         <http://purl.org/dc/terms/publisher> "Universidad Politecnica de Madrid" ;
                                         <http://purl.org/dc/terms/title> "The Tony Awards Ontology"@en ;
                                         <http://purl.org/vocab/vann/preferredNamespacePrefix> "tony" ;
                                         <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/tonyawards/ontology#" ;
                                         owl:versionInfo "1.0.0" ;
                                         <https://w3id.org/mod#createdWith> <https://chowlk.linkeddata.es/> .

