<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/tonyawards/ontology#"
     xml:base="https://w3id.org/tonyawards/ontology"
     xmlns:mod="https://w3id.org/mod#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/tonyawards/ontology#">
        <owl:versionIRI rdf:resource="https://w3id.org/tonyawards/ontology/1.0.0#"/>
        <terms:created>2026-05-17</terms:created>
        <terms:creator>Group7</terms:creator>
        <terms:description xml:lang="en">An ontology representing the Tony Awards, productions, theaters, and artists.</terms:description>
        <terms:issued>2026-05-17</terms:issued>
        <terms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <terms:publisher>Universidad Politecnica de Madrid</terms:publisher>
        <terms:title xml:lang="en">The Tony Awards Ontology</terms:title>
        <vann:preferredNamespacePrefix>tony</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/tonyawards/ontology#</vann:preferredNamespaceUri>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <mod:createdWith rdf:resource="https://chowlk.linkeddata.es/"/>
    </owl:Ontology>
    


